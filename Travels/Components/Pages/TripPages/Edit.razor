@page "/trips/edit"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Data.Sqlite
@using Travels.Models
@inject IDbContextFactory<Travels.Data.TravelsContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редагування поїздки — Travels</PageTitle>

<h1>Edit</h1>

<h2>Trip</h2>
<hr />
@if (Trip is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Trip" OnValidSubmit="UpdateTrip" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                @if (error is not null)
{
    <div class="alert alert-danger mt-2">@error</div>
}
                <input type="hidden" name="Trip.Id" value="@Trip.Id" />
                <div class="mb-3">
                    <label for="destination" class="form-label">Місце призначення:</label>
                    <InputText id="destination" @bind-Value="Trip.Destination" class="form-control" />
                    <ValidationMessage For="() => Trip.Destination" class="text-danger" />
                </div>
                <div class="mb-3">
                <label for="country" class="form-label">Країна:</label>
                <InputSelect id="country" @bind-Value="Trip.CountryId" class="form-select">
                    @foreach (var c in countries)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="mb-3">
                <label for="transport" class="form-label">Транспорт:</label>
                <InputSelect id="transport" @bind-Value="Trip.TransportId" class="form-select">
                    @foreach (var t in transports)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </InputSelect>
            </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Опис:</label>
                    <InputText id="description" @bind-Value="Trip.Description" class="form-control" />
                    <ValidationMessage For="() => Trip.Description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="startdate" class="form-label">Дата початку:</label>
                    <InputDate id="startdate" @bind-Value="Trip.StartDate" class="form-control" />
                    <ValidationMessage For="() => Trip.StartDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="enddate" class="form-label">Дата завершення:</label>
                    <InputDate id="enddate" @bind-Value="Trip.EndDate" class="form-control" />
                    <ValidationMessage For="() => Trip.EndDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="totalcost" class="form-label">Загальна вартість:</label>
                    <InputNumber id="totalcost" @bind-Value="Trip.TotalCost" class="form-control" />
                    <ValidationMessage For="() => Trip.TotalCost" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="isbusinesstrip" class="form-label">Це ділова поїздка:</label>
                    <InputCheckbox id="isbusinesstrip" @bind-Value="Trip.IsBusinessTrip" class="form-check-input" />
                    <ValidationMessage For="() => Trip.IsBusinessTrip" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Статус:</label>
                    <InputSelect id="status" @bind-Value="Trip.Status" class="form-control">
    @foreach (var status in Enum.GetValues<Travels.Models.TripStatus>())
    {
        <option value="@status">@status</option>
    }
</InputSelect>
                    <ValidationMessage For="() => Trip.Status" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/trips">Back to List</a>
</div>

@code {
    private string? error;
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Trip? Trip { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var db = DbFactory.CreateDbContext();
        
        countries = await db.Countries.OrderBy(c => c.Name).ToListAsync();
        transports = await db.Transports.OrderBy(t => t.Name).ToListAsync();

        Trip ??= await db.Trips
            .Include(x => x.Country)
            .Include(x => x.Transport)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (Trip is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    public async Task UpdateTrip()
{
    Trip.DestinationSearch = Trip.Destination.ToLowerInvariant();
    error = null;

    if (Trip.EndDate < Trip.StartDate)
    {
        error = "Дата завершення не може передувати даті початку поїздки";
        return;
    }

    using var context = DbFactory.CreateDbContext();
    context.Attach(Trip!).State = EntityState.Modified;

    try
    {
        await context.SaveChangesAsync();
    }
    catch (DbUpdateConcurrencyException)
    {
        if (!TripExists(Trip!.Id))
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }
        else
        {
            throw;
        }
    }
    catch (DbUpdateException ex) when (ex.InnerException is SqliteException { SqliteExtendedErrorCode: 2067 })
    {
        error = "Поїздка в це місце на таку дату вже існує";
        return;
    }

    NavigationManager.NavigateTo("/trips");
}

    private bool TripExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Trips.Any(e => e.Id == id);
    }

    private List<Country> countries = new();
    private List<Transport> transports = new();

    
}
